{
  "name": "triprescue-xrpl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -n api,web -c cyan,magenta \"node --watch server/index.js\" \"node ./node_modules/vite/bin/vite.js\"",
    "start": "node server/index.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "check": "node ./node_modules/typescript/bin/tsc --noEmit && node --test server/*.test.js src/*.test.js",
    "wallet:setup": "node scripts/setup-wallets.js",
    "demo:x402": "node scripts/demo-x402.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xrpl": "^4.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
